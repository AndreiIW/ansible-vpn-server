[Interface]
Address = {{ awg_server_ip }}
ListenPort = {{ awg_port }}
PrivateKey = {{ server_private_key }}
Jc = {{ awg_jc }}
Jmin = {{ awg_jmin }}
Jmax = {{ awg_jmax }}
S1 = {{ awg_s1 }}
S2 = {{ awg_s2 }}
S3 = {{ awg_s3 }}
S4 = {{ awg_s4 }}
H1 = {{ awg_h1_range }}
H2 = {{ awg_h2_range }}
H3 = {{ awg_h3_range }}
H4 = {{ awg_h4_range }}
PostUp = nft add table inet awg-awg0
PostUp = nft add chain inet awg-awg0 input '{ type filter hook input priority 0 ; policy accept ; }'
PostUp = nft add rule inet awg-awg0 input udp dport {{ awg_port }} accept
PostUp = nft add chain inet awg-awg0 forward '{ type filter hook forward priority 0 ; policy accept ; }'
PostUp = nft add rule inet awg-awg0 forward oifname awg0 tcp flags '&' '(syn|rst)' == syn tcp option maxseg size set rt mtu
PostUp = nft add rule inet awg-awg0 forward iifname awg0 accept
PostUp = nft add rule inet awg-awg0 forward iifname {{ ansible_facts['default_ipv4']['interface'] }} oifname awg0 accept
PostUp = nft add chain inet awg-awg0 postrouting '{ type nat hook postrouting priority 100 ; policy accept ; }'
PostUp = nft add rule inet awg-awg0 postrouting oifname {{ ansible_facts['default_ipv4']['interface'] }} masquerade
PostDown = nft delete table inet awg-awg0

### Client client
[Peer]
PublicKey = {{ client_public_key }}
PresharedKey = {{ client_preshared_key }}
AllowedIPs = {{ awg_client_ip }}
