server {
    server_name {{ active_server_name }};
    access_log /var/log/nginx/{{ active_server_name }}-access.log;
    error_log /var/log/nginx/{{ active_server_name }}-error.log;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen 443 ssl;
    ssl_certificate {{ ssl_cert_path }};
    ssl_certificate_key {{ ssl_key_path }};
    
{% if cert_mode == 'domain' or cert_mode == 'public_ip' %}
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
{% endif %}

    # Закрываем паролем всю админку
    auth_basic "Админка закрыта паролем";
    auth_basic_user_file /etc/nginx/.htpasswd;
}

server {
    if ($host = {{ active_server_name }}) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    server_name {{ active_server_name }};
    return 404;
}
