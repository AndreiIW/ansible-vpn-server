
*filter
:INPUT ACCEPT [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]

################ Входящий трафик ################

# Разрешаем связанные и установленые соединения
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT

# Разрешаем любой входящий трафик на интерфейсе loopback
-A INPUT -i lo -j ACCEPT

# Разрешаем входящий служебный icmp-трафик
-A INPUT -p icmp -j ACCEPT

# Разрешаем трафик до Web server
-A INPUT -i {{ ansible_facts['default_ipv4']['interface'] }} -p tcp -m conntrack --ctstate NEW -m multiport --dports 80,443 -j ACCEPT

# Разрешаем трафик для SSH
-A INPUT -i {{ ansible_facts['default_ipv4']['interface'] }} -p tcp -m conntrack --ctstate NEW --dport 22 -j ACCEPT

# Разрешаем трафик для Telegram MTProxy
-A INPUT -i {{ ansible_facts['default_ipv4']['interface'] }} -p tcp -m conntrack --ctstate NEW --dport 8443 -j ACCEPT

# Блокирую левые, сломанные или поддельные пакеты, на сетевой карте смотрящей в интернет
-A INPUT -i {{ ansible_facts['default_ipv4']['interface'] }} -m conntrack --ctstate INVALID -j DROP

# Запрещаем всё остальное пакеты с сообщением узел запрещен
-A INPUT -j REJECT --reject-with icmp-host-prohibited


################ Исходящий трафик ################



################ Транзитный (FORWARD) трафик ################

-A FORWARD -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A FORWARD -p icmp -j ACCEPT


COMMIT
