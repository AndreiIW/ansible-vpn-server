# amneziawg-web environment configuration
# Сгенерировано Ansible
# Manage with: sudo systemctl restart amneziawg-web

# ── Authentication ────────────────────────────────────────────────────────────
AUTH_ENABLED=true
AUTH_USERNAME={{ amneziawg_web_admin_user }}
AUTH_PASSWORD_HASH={{ admin_password_hash.stdout }}
AUTH_SESSION_TTL_SECS=86400
AUTH_SECURE_COOKIE=false

# Optional bearer token for headless API access.
# Uncomment and set to a 32-byte hex secret: openssl rand -hex 32
# AUTH_API_TOKEN=

# ── Server ────────────────────────────────────────────────────────────────────
AWG_WEB_LISTEN=127.0.0.1:8080
AWG_WEB_DB=/var/lib/amneziawg-web/awg-web.db

# ── AWG integration ───────────────────────────────────────────────────────────
AWG_CONFIG_DIR=/etc/amnezia/amneziawg/clients
AWG_POLL_INTERVAL=30
AWG_PROXY_SESSIONS_FILE=/var/lib/amneziawg-proxy/sessions.json

# ── Logging ───────────────────────────────────────────────────────────────────
RUST_LOG=amneziawg_web=info
